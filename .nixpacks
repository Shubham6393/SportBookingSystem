[phases.setup]
nixPkgs = [
    "php80",
    "php80Packages.curl",
    "php80Packages.mbstring",
    "php80Packages.xml",
    "php80Packages.openssl",
    "php80Packages.pdo",
    "php80Packages.tokenizer",
    "php80Packages.mysqli",
    "composer"
]

[phases.install]
cmds = [
    "composer install --no-dev --optimize-autoloader"
] 